<Window x:Class="CopilotPlusDemoHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot+ PC Demo • Microsoft Foundry Local"
        Width="1200" Height="700"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0" MouseDown="Header_MouseDown">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CopilotBlueBrush}" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="LblTitle" Text="COPILOT+ PC DEMO" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LblSubtitle" Text="Intelligence Artificielle sur Silicium Dédié • Microsoft Foundry Local" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Merged Accelerator Selector & Dynamic Silicon Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblAccelerator" Text="ACCÉLÉRATEUR :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton x:Name="RadNpu" GroupName="DeviceGrp" Content="⚡ NPU" IsChecked="True" Style="{StaticResource PillButtonStyle}" Checked="Accelerator_Checked" />
                    <RadioButton x:Name="RadGpu" GroupName="DeviceGrp" Content="🎮 GPU" Style="{StaticResource PillButtonStyle}" Checked="Accelerator_Checked" />
                    <RadioButton x:Name="RadCpu" GroupName="DeviceGrp" Content="💻 CPU" Style="{StaticResource PillButtonStyle}" Checked="Accelerator_Checked" />
                    <RadioButton x:Name="RadAuto" GroupName="DeviceGrp" Content="🤖 Auto" Style="{StaticResource PillButtonStyle}" Checked="Accelerator_Checked" ToolTip="Foundry Local sélectionne automatiquement le meilleur accélérateur (priorité NPU)" />

                    <!-- Merged Hardware Architecture & Choice Indicator -->
                    <Border Background="#1A253A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotArchitecture" Width="8" Height="8" Fill="{StaticResource NpuGreenBrush}" Margin="0,0,7,0" />
                            <TextBlock x:Name="TxtArchitecture" Text="Intel Lunar Lake • NPU 48 TOPS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header Quick Access: Telemetry & Audit Console (2 lines) -->
                <Button Grid.Column="4" x:Name="BtnHeaderTelemetry" Style="{StaticResource ModernButtonStyle}"
                        Background="#0F243E" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1"
                        Padding="10,3" Height="36" Click="BtnHeaderTelemetry_Click" ToolTip="Ouvrir la console de Gouvernance &amp; Télémétrie Flotte">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderTelemetry1" Text="Télémétrie" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" LineHeight="12" />
                            <TextBlock x:Name="TxtHeaderTelemetry2" Text="&amp; Audit" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" LineHeight="12" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Header Quick Access: Documentation & Guide (FR / EN) - Icon only -->
                <Button Grid.Column="6" x:Name="BtnHeaderDoc" Style="{StaticResource ModernButtonStyle}"
                        Background="#0F243E" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1"
                        Width="36" Height="36" Padding="0" Click="BtnHeaderDoc_Click" ToolTip="Documentation globale du projet, prérequis, architecture &amp; binaires (FR / EN)">
                    <TextBlock Text="❓" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Language Toggle Button [ 🇫🇷 FR ⇄ EN / 🇬🇧 EN ⇄ FR ] -->
                <Button Grid.Column="8" x:Name="BtnLanguageToggle" Style="{StaticResource ModernButtonStyle}"
                        Background="#0F243E" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1"
                        Padding="10,4" Height="36" Click="BtnLanguageToggle_Click"
                        ToolTip="Basculer la langue / Toggle language (FR / EN)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLangFlag" Text="🇫🇷" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtLangCurrent" Text="FR" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="⇄" FontSize="11" Foreground="{StaticResource CopilotCyanBrush}" Margin="6,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtLangOther" Text="EN" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Right: Window State Toggle (Fullscreen / Windowed) -->
                <Button Grid.Column="10" x:Name="BtnWindowToggle" Style="{StaticResource ModernButtonStyle}"
                        Background="#1A253A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Padding="10,6" Click="BtnWindowToggle_Click" ToolTip="Basculer Plein écran / Fenêtré (F11)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="IconWindowToggle" Text="🗖" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource CopilotCyanBrush}" />
                        <TextBlock x:Name="TxtWindowToggle" Text="Plein écran" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar + Dynamic Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock x:Name="LblNavBusiness" Text="CAS D'USAGE MÉTIERS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,4,0,8" />

                            <RadioButton x:Name="NavOperations" GroupName="NavGrp" Content="🏢  Opérations &amp; CVC" IsChecked="True" Style="{StaticResource NavButtonStyle}" Checked="NavOperations_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavEngineering" GroupName="NavGrp" Content="⚙️  Ingénierie &amp; RAG" Style="{StaticResource NavButtonStyle}" Checked="NavEngineering_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavInsurance" GroupName="NavGrp" Content="📋  Assurance Sinistres" Style="{StaticResource NavButtonStyle}" Checked="NavInsurance_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavFinancial" GroupName="NavGrp" Content="💼  Services Financiers" Style="{StaticResource NavButtonStyle}" Checked="NavFinancial_Checked" Margin="0,0,0,3" />

                            <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="6,8,6,8" />

                            <TextBlock x:Name="LblNavSilicon" Text="DÉMONSTRATIONS SILICIUM" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,8" />

                            <RadioButton x:Name="NavBenchmark" GroupName="NavGrp" Content="🔋  Benchmark Watts &amp; Énergie" Style="{StaticResource NavButtonStyle}" Checked="NavBenchmark_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavOliveLab" GroupName="NavGrp" Content="🧪  Laboratoire Olive AI" Style="{StaticResource NavButtonStyle}" Checked="NavOliveLab_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavAudio" GroupName="NavGrp" Content="🎙️  Transcription Vocale (Whisper)" Style="{StaticResource NavButtonStyle}" Checked="NavAudio_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavAvatar" GroupName="NavGrp" Content="🎨  Studio Avatar Cartoon 3D" Style="{StaticResource NavButtonStyle}" Checked="NavAvatar_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavEraser" GroupName="NavGrp" Content="🧹  Gomme Magique &amp; Inpainting" Style="{StaticResource NavButtonStyle}" Checked="NavEraser_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavPdfStudio" GroupName="NavGrp" Content="📑  Studio PDF &amp; OCR Souverain" Style="{StaticResource NavButtonStyle}" Checked="NavPdfStudio_Checked" Margin="0,0,0,3" />
                            <RadioButton x:Name="NavSecurityAccess" GroupName="NavGrp" Content="🛡️  Contrôle d'Accès &amp; Démineur" Style="{StaticResource NavButtonStyle}" Checked="NavSecurityAccess_Checked" Margin="0,0,0,3" />

                            <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="6,8,6,8" />

                            <TextBlock x:Name="LblNavGovernance" Text="GOUVERNANCE &amp; CONTRÔLE IT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" Margin="8,0,0,8" />

                            <Border Background="#10253F" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1" CornerRadius="6">
                                <RadioButton x:Name="NavFleetTelemetry" GroupName="NavGrp" Content="🛡️  Télémétrie &amp; Audit Flotte" Style="{StaticResource NavButtonStyle}" Checked="NavFleetTelemetry_Checked" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Privacy & Endpoint Badges -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <Border Background="#131F33" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="LblSecurityTitle" Text="🛡️ Sécurité &amp; Souveraineté" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource NpuGreenBrush}" />
                                <TextBlock x:Name="LblSecurityDesc" Text="Toutes les inférences et données restent confinées à ce PC." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Content Container -->
            <ContentControl Grid.Column="1" x:Name="ViewContainer" />
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource NpuGreenBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="LblServerStatus" Text="Foundry Local connecté (127.0.0.1) • Modèle chargé : phi-4-mini (OpenVINO NPU)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock x:Name="LblStatusFooter" Grid.Column="1" Text="Copilot+ PC Hub v2.0 • PoC Client Exécutif" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
