<UserControl x:Class="CopilotPlusDemoHub.UI.Views.AiParadigmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Background="#060A12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ======================================================== -->
                <!-- 1. HEADER TITLE & ACCELERATOR TELEMETRY PILLS            -->
                <!-- ======================================================== -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🩺" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LblTitle" Text="PANORAMA IA : SLM STANDARD, SLM MÉTIER, NLU &amp; AGENT MÉDICAL"
                                       FontSize="16" FontWeight="Black"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="LblSubtitle" Text="Cas d'usage souverain : Consultation Médicale locale. Comprendre la valeur clinique, la détection d'oublis et l'exécution d'un Agent actif sur PC Copilot+."
                                   FontSize="11.5" Margin="32,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Border Background="#0C1424" BorderBrush="#2A3B5C" BorderThickness="1" CornerRadius="16" Padding="10,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource NpuGreenBrush}" Margin="0,0,6,0" />
                                <TextBlock x:Name="LblComplianceBadge" Text="100% Souverain • Inférence NPU/GPU" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource NpuGreenBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#162238" BorderBrush="{StaticResource CopilotBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtActiveDevice" Text="NPU (DirectML / OpenVINO)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnDocHelp" Style="{StaticResource ModernButtonStyle}"
                                Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                Height="28" Padding="10,0" Margin="0,0,0,4"
                                ToolTip="Fiche explicative détaillée et guide d'orientation client" Click="BtnDocHelp_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="❓" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock x:Name="TxtDocHelp" Text="Guide Décisionnel" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- 2. SCENARIO SELECTOR & INPUT PROMPT CARD                 -->
                <!-- ======================================================== -->
                <Border Grid.Row="1" Background="#0C1424" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Preset Scenarios -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="LblSelectScenario" Text="Scénario Métier :" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RadScenarioMedical" GroupName="ScenarioGrp" IsChecked="True"
                                             Style="{StaticResource PillButtonStyle}" Height="28" FontSize="11" FontWeight="Bold"
                                             Checked="Scenario_Checked">
                                    <TextBlock Text="🩺 Consultation Cabinet (Lombalgie &amp; Kardégic)" />
                                </RadioButton>
                                <RadioButton x:Name="RadScenarioPediatric" GroupName="ScenarioGrp"
                                             Style="{StaticResource PillButtonStyle}" Height="28" FontSize="11" FontWeight="SemiBold"
                                             Checked="Scenario_Checked">
                                    <TextBlock Text="👶 Urgences Pédiatrie (Fièvre &amp; Posologie Poids)" />
                                </RadioButton>
                                <RadioButton x:Name="RadScenarioCardio" GroupName="ScenarioGrp"
                                             Style="{StaticResource PillButtonStyle}" Height="28" FontSize="11" FontWeight="SemiBold"
                                             Checked="Scenario_Checked">
                                    <TextBlock Text="💊 Cardiologie (Insuffisance rénale &amp; Conflit AINS)" />
                                </RadioButton>
                                <RadioButton x:Name="RadScenarioCustom" GroupName="ScenarioGrp"
                                             Style="{StaticResource PillButtonStyle}" Height="28" FontSize="11" FontWeight="SemiBold"
                                             Checked="Scenario_Checked">
                                    <TextBlock Text="✍️ Saisie Libre (Prompt Médecin / Client)" />
                                </RadioButton>
                            </WrapPanel>
                        </Grid>

                        <!-- Input Request Box -->
                        <Border Grid.Row="1" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBox x:Name="TxtInputPrompt" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                                     FontSize="11.5" FontFamily="Segoe UI" MinHeight="48" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                     Text="M. Robert (64 ans, suivi pour cardiopathie sous Kardégic 75 mg) : 'Bonjour Docteur, j'ai une violente douleur dans le bas du dos depuis 3 jours. Prescrivez-moi un anti-inflammatoire puissant comme de l'Ibuprofène 400 mg pour calmer l'inflammation !'" />
                        </Border>

                        <!-- Action Bar: Run All Button & Mode Selector -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnRunAllParadigms" Style="{StaticResource ModernButtonStyle}"
                                    Background="#0284C7" Height="36" Padding="18,0" FontWeight="Bold" FontSize="12"
                                    Click="BtnRunAllParadigms_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtBtnRunAll" Text="Évaluer les 4 Approches en Simultané" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="LblViewMode" Text="Affichage :" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton x:Name="RadViewGrid" GroupName="ViewModeGrp" IsChecked="True" Content="Grid 2x2" Style="{StaticResource PillButtonStyle}" Height="24" FontSize="10.5" Checked="ViewMode_Checked" Margin="0,0,4,0" />
                                <RadioButton x:Name="RadViewTabs" GroupName="ViewModeGrp" Content="Détail par Onglet" Style="{StaticResource PillButtonStyle}" Height="24" FontSize="10.5" Checked="ViewMode_Checked" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LblGlobalStatus" Text="Prêt. Cliquez sur Évaluer pour lancer l'inférence locale sur NPU." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- 3. MAIN FOUR-PARADIGM COMPARISON AREA                    -->
                <!-- ======================================================== -->
                <!-- MODE A: GRID 2x2 (ALL FOUR IN VIEW) -->
                <Grid x:Name="ContainerGrid" Grid.Row="2" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: SLM GÉNÉRIQUE (BRUT) -->
                    <Border x:Name="CardSlmRaw" Grid.Row="0" Grid.Column="0" Background="#0C1424" BorderBrush="#3B2667" BorderThickness="1.5" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="190" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header Card 1 -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#2E1065" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="NIVEAU 1" FontSize="9.5" FontWeight="Bold" Foreground="#C084FC" />
                                    </Border>
                                    <TextBlock Text="🟣 SLM STANDARD (SANTÉ GÉNÉRALE)" FontSize="12.5" FontWeight="Bold" Foreground="#D8B4FE" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRunSlmRaw" Content="▶ Lancer" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="22" Padding="8,0" FontSize="10" Click="BtnRunSlmRaw_Click" />
                            </Grid>

                            <!-- Role description -->
                            <TextBlock Grid.Row="1" x:Name="LblRoleSlmRaw" Text="Modèle compact standard (Phi-4 mini) sans base pharmacologique ni dossier patient. Vulgarisation grand public, ignore les risques vitaux." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Response Area -->
                            <Border Grid.Row="2" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <TextBox x:Name="TxtOutputSlmRaw" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                             FontSize="11" FontFamily="Consolas, Segoe UI"
                                             Text="En attente du lancement..." />
                                </ScrollViewer>
                            </Border>

                            <!-- Live Telemetry Pill -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="TxtTelemetrySlmRaw" Text="⚡ Latence: -- ms • Vitesse: -- tok/s" FontSize="10" Foreground="#A5B4FC" />
                                </Border>
                                <Border Background="#0C1424" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock Text="Format: Texte Grand Public" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </WrapPanel>

                            <!-- Collapsible Pedagogical Guide -->
                            <Border Grid.Row="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="💡 Pourquoi insuffisant en consultation ?" FontSize="10" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,3" />
                                    <TextBlock Text="✗ Ignore les antécédents cardiaques du patient.&#x0a;✗ Propose volontiers de l'Ibuprofène en vente libre sans déceler l'interaction mortelle avec le Kardégic." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 2: SLM MÉTIER (PHARMACOPÉE & VIDAL) -->
                    <Border x:Name="CardSlmDomain" Grid.Row="0" Grid.Column="2" Background="#0C1424" BorderBrush="#0369A1" BorderThickness="1.5" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="190" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header Card 2 -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#082F49" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="NIVEAU 2" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                                    </Border>
                                    <TextBlock Text="🔵 SLM MÉTIER (PHARMACOPÉE &amp; VIDAL)" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRunSlmDomain" Content="▶ Lancer" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="22" Padding="8,0" FontSize="10" Click="BtnRunSlmDomain_Click" />
                            </Grid>

                            <!-- Role description -->
                            <TextBlock Grid.Row="1" x:Name="LblRoleSlmDomain" Text="SLM spécialisé sur les monographies ANSM / VIDAL, effets secondaires, posologies rénales et contre-indications croisées absolues." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Response Area -->
                            <Border Grid.Row="2" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <TextBox x:Name="TxtOutputSlmDomain" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                             FontSize="11" FontFamily="Consolas, Segoe UI"
                                             Text="En attente du lancement..." />
                                </ScrollViewer>
                            </Border>

                            <!-- Live Telemetry Pill -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#082F49" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="TxtTelemetrySlmDomain" Text="⚡ Latence: -- ms • Vitesse: -- tok/s" FontSize="10" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#0C1424" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock Text="Format: Analyse Médicamenteuse" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </WrapPanel>

                            <!-- Collapsible Pedagogical Guide -->
                            <Border Grid.Row="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="💡 Quelle est sa valeur et sa limite ?" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,3" />
                                    <TextBlock Text="✓ Détecte immédiatement le danger AINS + Kardégic (hémorragie digestive).&#x0a;✗ Reste passif : ne dialogue pas avec le patient, ne gère pas la carte vitale ni la facturation." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 3: NLU MÉTIER (COMPRÉHENSION CONTEXTE & OUBLIS) -->
                    <Border x:Name="CardNlu" Grid.Row="2" Grid.Column="0" Background="#0C1424" BorderBrush="#047857" BorderThickness="1.5" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="190" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header Card 3 -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="NIVEAU 3" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                    </Border>
                                    <TextBlock Text="🟢 NLU MÉTIER (CONTEXTE &amp; OUBLIS)" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRunNlu" Content="▶ Lancer" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="22" Padding="8,0" FontSize="10" Click="BtnRunNlu_Click" />
                            </Grid>

                            <!-- Role description -->
                            <TextBlock Grid.Row="1" x:Name="LblRoleNlu" Text="Compréhension du dialogue clinique et du contexte patient : antécédents résolus, symptômes extraits ET détection des oublis (Carte Vitale, constantes)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Response Area -->
                            <Border Grid.Row="2" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <TextBox x:Name="TxtOutputNlu" Background="Transparent" Foreground="#6EE7B7"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                             FontSize="10.5" FontFamily="Consolas"
                                             Text="En attente du lancement..." />
                                </ScrollViewer>
                            </Border>

                            <!-- Live Telemetry Pill -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="TxtTelemetryNlu" Text="⚡ Latence: -- ms • Contexte &amp; Oublis Détectés" FontSize="10" Foreground="#34D399" />
                                </Border>
                                <Border Background="#0C1424" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock Text="Format: JSON Contexte &amp; Oublis" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </WrapPanel>

                            <!-- Collapsible Pedagogical Guide -->
                            <Border Grid.Row="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="💡 La rupture apportée par le NLU Métier :" FontSize="10" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,3" />
                                    <TextBlock Text="✓ Repère ce qui a été dit (douleur lombaire L4-L5, Kardégic) ET ce qui manque (Carte Vitale non demandée, tension omise).&#x0a;✗ Ne prend pas de décision d'action par lui-même (nécessite l'Agent)." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 4: AGENT MÉTIER (COPILOTE ACTIF DU MÉDECIN) -->
                    <Border x:Name="CardAgent" Grid.Row="2" Grid.Column="2" Background="#0C1424" BorderBrush="#B45309" BorderThickness="1.5" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="170" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header Card 4 -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#451A03" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="NIVEAU 4" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24" />
                                    </Border>
                                    <TextBlock Text="🟠 AGENT MÉTIER (COPILOTE ACTIF)" FontSize="12.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRunAgent" Content="▶ Lancer" Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="24" Padding="10,0" FontSize="10.5" FontWeight="Bold" Click="BtnRunAgent_Click" />
                            </Grid>

                            <!-- Mode Selector Toggle: Pas-à-Pas vs Médecin Réel -->
                            <Border Grid.Row="1" Background="#141E2E" BorderBrush="#2A3B5C" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mode Agent :" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" Margin="2,0,8,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="RadAgentStepByStep" GroupName="AgentModeGrp" IsChecked="True" Content="👣 Pas-à-Pas (Interactif)" Style="{StaticResource PillButtonStyle}" Height="22" FontSize="9.5" FontWeight="Bold" Checked="AgentMode_Checked" Margin="0,0,4,0" />
                                        <RadioButton x:Name="RadAgentRealDoctor" GroupName="AgentModeGrp" Content="🩺 Médecin Réel (Temps Réel)" Style="{StaticResource PillButtonStyle}" Height="22" FontSize="9.5" FontWeight="Bold" Checked="AgentMode_Checked" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Interactive Step-by-Step HUD Action Bar -->
                            <Border Grid.Row="2" x:Name="PanelAgentStepActions" Background="#1C1917" BorderBrush="#78350F" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnStep1Dossier" Content="1️⃣ Dossier Patient" Style="{StaticResource ModernButtonStyle}" Background="#292524" Height="22" Padding="6,0" FontSize="9.5" Margin="0,0,4,2" Click="BtnStep1Dossier_Click" />
                                    <Button x:Name="BtnStep2Vitale" Content="2️⃣ 💳 Demander Carte Vitale" Style="{StaticResource ModernButtonStyle}" Background="#78350F" Height="22" Padding="6,0" FontSize="9.5" FontWeight="Bold" Margin="0,0,4,2" Click="BtnStep2Vitale_Click" />
                                    <Button x:Name="BtnStep3Subst" Content="3️⃣ 🛡️ Paracétamol (Sécurité)" Style="{StaticResource ModernButtonStyle}" Background="#9A3412" Height="22" Padding="6,0" FontSize="9.5" FontWeight="Bold" Margin="0,0,4,2" Click="BtnStep3Subst_Click" />
                                    <Button x:Name="BtnStep4Finalize" Content="4️⃣ 📑 Facture SESAM &amp; DMP" Style="{StaticResource ModernButtonStyle}" Background="#065F46" Height="22" Padding="6,0" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,2" Click="BtnStep4Finalize_Click" />
                                </WrapPanel>
                            </Border>

                            <!-- Response Area -->
                            <Border Grid.Row="3" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                    <TextBox x:Name="TxtOutputAgent" Background="Transparent" Foreground="#FDE68A"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                             FontSize="11" FontFamily="Consolas, Segoe UI"
                                             Text="En attente du lancement..." />
                                </ScrollViewer>
                            </Border>

                            <!-- Live Telemetry Pill -->
                            <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="TxtTelemetryAgent" Text="⚡ Latence: -- ms • 4 Actions Réalisées" FontSize="10" Foreground="#FBBF24" />
                                </Border>
                                <Border Background="#0C1424" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="TxtStatusAgentDeliverables" Text="Livrables : SESAM-Vitale • Compte-Rendu • DMP" FontSize="10" Foreground="#6EE7B7" />
                                </Border>
                            </WrapPanel>

                            <!-- Collapsible Pedagogical Guide -->
                            <Border Grid.Row="5" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="💡 Le rôle déterminant de l'Agent Médical :" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,3" />
                                    <TextBlock Text="✓ Bloque activement la prescription à risque vital, rappelle la carte vitale, génère la feuille de soins (26,50 €) et sauvegarde le DMP localement." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======================================================== -->
                <!-- 4. COMPARISON MATRIX (EXECUTIVE SUMMARY TABLE)           -->
                <!-- ======================================================== -->
                <Border Grid.Row="3" Background="#0C1424" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblMatrixTitle" Text="📊 MATRICE DÉCISIONNELLE : QUELLE ARCHITECTURE CHOISIR POUR VOTRE PROJET ?" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" Margin="0,0,0,10" />

                        <!-- Summary Table -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <!-- Header Row -->
                            <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#131F33" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Critère Décisionnel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="🟣 SLM Brut" FontSize="11" FontWeight="Bold" Foreground="#C084FC" />
                                    <TextBlock Grid.Column="2" Text="🔵 SLM Métier" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                    <TextBlock Grid.Column="3" Text="🟢 NLU Métier" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                    <TextBlock Grid.Column="4" Text="🟠 Agent Métier" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                                </Grid>
                            </Border>

                            <!-- Row 1: Destination -->
                            <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#080E1C" Padding="8,6" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Consommateur de la sortie" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Grand Public (Lecture)" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Médecin / Pharmacien" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Logiciel Cabinet / DMP" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                                    <TextBlock Grid.Column="4" Text="Consultation Complète" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </Grid>
                            </Border>

                            <!-- Row 2: Contexte & Oublis -->
                            <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#060A12" Padding="8,6" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Contexte Patient &amp; Oublis" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Nul (Ignore l'historique)" FontSize="10.5" Foreground="#EF4444" />
                                    <TextBlock Grid.Column="2" Text="Notices Vidal seules" FontSize="10.5" Foreground="#38BDF8" />
                                    <TextBlock Grid.Column="3" Text="100% (Carte Vitale / TA)" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                                    <TextBlock Grid.Column="4" Text="100% + Alerte Proactive" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </Grid>
                            </Border>

                            <!-- Row 3: Sécurité Médicamenteuse -->
                            <Border Grid.Row="3" Grid.ColumnSpan="5" Background="#080E1C" Padding="8,6" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vigilance Prescription" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Dangereux (Propose AINS)" FontSize="10.5" Foreground="#EF4444" />
                                    <TextBlock Grid.Column="2" Text="Alerte Vidal Passive" FontSize="10.5" Foreground="#38BDF8" />
                                    <TextBlock Grid.Column="3" Text="Flag Incompatibilité" FontSize="10.5" Foreground="#34D399" />
                                    <TextBlock Grid.Column="4" Text="Blocage &amp; Substitution" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </Grid>
                            </Border>

                            <!-- Row 4: Action & Livrables -->
                            <Border Grid.Row="4" Grid.ColumnSpan="5" Background="#060A12" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Capacité d'Action Réelle" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Nulle (Texte seul)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="Nulle (Conseil)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="Nulle (JSON brut)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="4" Text="TOTALE (SESAM, DMP)" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
