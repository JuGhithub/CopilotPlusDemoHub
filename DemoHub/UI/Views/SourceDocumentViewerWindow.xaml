<Window x:Class="CopilotPlusDemoHub.UI.Views.SourceDocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Source • Copilot+ Demo"
        Width="960" Height="680"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B132B"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#0F1E36" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A8A" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtDocIcon" Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDocTitle" Text="Document Source" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Background="#162B4D" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtDocBadgeType" Text="Texte Brut" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                            </Border>
                            <Border Background="#132E27" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtDocBadgePrivacy" Text="🛡️ Donnée 100% Locale" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource NpuGreenBrush}" />
                            </Border>
                            <TextBlock x:Name="TxtDocStats" Text="0 lignes • 0 Ko" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyContent" Style="{StaticResource ModernButtonStyle}"
                            Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnCopyContent_Click"
                            ToolTip="Copier le contenu complet dans le presse-papier">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtBtnCopy" Text="Copier" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnOpenExternal" Style="{StaticResource ModernButtonStyle}"
                            Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnOpenExternal_Click"
                            ToolTip="Ouvrir dans l'éditeur système par défaut (Bloc-notes...)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📂" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtBtnExternal" Text="Éditeur externe" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClose" Style="{StaticResource ModernButtonStyle}"
                            Background="#2D1F2D" BorderBrush="#7F1D1D" BorderThickness="1"
                            Height="32" Padding="14,0" Click="BtnClose_Click">
                        <TextBlock x:Name="TxtBtnClose" Text="✕ Fermer" FontSize="11.5" FontWeight="SemiBold" Foreground="#FCA5A5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Search & Filter Bar -->
        <Border Grid.Row="1" Background="#0B1528" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch"
                         Background="#080E1D" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                         Padding="10,6" FontSize="12" VerticalAlignment="Center"
                         TextChanged="TxtSearch_TextChanged" />

                <TextBlock x:Name="TxtSearchResults" Grid.Column="1"
                           Text="" FontSize="11" Foreground="{StaticResource CopilotCyanBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Document Content Viewer -->
        <Border Grid.Row="2" Background="#060C18" Padding="16">
            <TextBox x:Name="TxtDocumentBody"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                     FontSize="12.5"
                     Background="Transparent"
                     Foreground="#E2E8F0"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </Border>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#080F1E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFilePath" Text="Localisation locale : --" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtFooterTag" Grid.Column="1" Text="Contexte d'inférence sécurisé • Zéro transfert réseau" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NpuGreenBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
