<UserControl x:Class="CopilotPlusDemoHub.UI.Views.EngineeringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- View Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="LblEngTitle" Text="ASSISTANT INGÉNIERIE TECHNIQUE (RAG LOCAL)"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="LblEngSub" Text="Recherche documentaire sur appareil • Confidentialité absolue • Références exactes sans hallucination"
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="BadgeModelContainer" Background="#162238" BorderBrush="{StaticResource CopilotBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Modèles d'Intelligence Artificielle exécutés localement">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtModelBadge" Text="Modèles : BGE-Small (Embeddings) + Phi-4-mini (RAG)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="BtnDocHelp" Style="{StaticResource ModernButtonStyle}"
                        Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Height="32" Padding="12,0" VerticalAlignment="Center"
                        ToolTip="Documentation &amp; Guide de démonstration (FR / EN)" Click="BtnDocHelp_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="❓" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtDocHelp" Text="Guide &amp; Doc" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Two Columns Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Document & Question Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="LblKnowledgeBase" Text="BASE TECHNIQUE LOCALE"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource CopilotCyanBrush}"
                                   Margin="0,0,0,16" />

                        <!-- Document Badge -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDocTitle" Text="📄 Manuel_Maintenance_CVC_Industriel.txt"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="LblDocSub" Text="Indexé sur cet appareil • 480 lignes • Connaissances d'entreprise"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnViewSourceDoc" Style="{StaticResource ModernButtonStyle}"
                                        Background="#162238" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1"
                                        Height="28" Padding="10,0" Margin="8,0,0,0" Click="BtnViewSourceDoc_Click"
                                        ToolTip="Consulter l'intégralité du manuel ou document technique indexé">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👁️" FontSize="11" Margin="0,0,5,0" />
                                        <TextBlock x:Name="TxtBtnViewSourceDoc" Text="Voir le Manuel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Document Import & Reset Controls -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnImportDoc" Grid.Column="0"
                                    Content="📁 Importer un document"
                                    Margin="0,0,8,0" Padding="10,6" FontSize="11" FontWeight="SemiBold"
                                    Background="#2563EB" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="BtnImportDoc_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnResetDoc" Grid.Column="1"
                                    Content="🔄 Manuel CVC"
                                    Padding="10,6" FontSize="11"
                                    Background="#1E293B" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                    Cursor="Hand" Click="BtnResetDoc_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="LblQuestionLabel" Text="Question d'ingénierie soumise"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="TxtQuestion"
                                 Text="Quelles sont les causes possibles de vibrations excessives du ventilateur et les tolérances admissibles ?"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                                 Background="{StaticResource InputBgBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource CardBorderBrush}"
                                 Padding="10,8" Margin="0,0,0,12" />

                        <!-- Suggestions Pills -->
                        <TextBlock x:Name="LblSuggestionsLabel" Text="Questions suggérées :"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Button x:Name="BtnSuggestion1" Content="Vibrations excessives"
                                    Margin="0,0,6,6" Padding="8,4" FontSize="11"
                                    Background="#26334D" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="Suggestion1_Click" />
                            <Button x:Name="BtnSuggestion2" Content="Consignes de lubrification"
                                    Margin="0,0,6,6" Padding="8,4" FontSize="11"
                                    Background="#26334D" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="Suggestion2_Click" />
                            <Button x:Name="BtnSuggestion3" Content="Tolérances d'alignement"
                                    Margin="0,0,6,6" Padding="8,4" FontSize="11"
                                    Background="#26334D" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="Suggestion3_Click" />
                            <Button x:Name="BtnSuggestion4" Content="Filtres HEPA &amp; Salle Propre"
                                    Margin="0,0,6,6" Padding="8,4" FontSize="11"
                                    Background="#26334D" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="Suggestion4_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Bottom Action Button & Status -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="BtnRun"
                                Content="▶ Interroger la documentation"
                                Style="{StaticResource ModernButtonStyle}"
                                Height="42"
                                Click="BtnRun_Click" />

                        <ProgressBar x:Name="PrgBusy"
                                     IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,8,0,0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Response & Telemetry Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Guidance Header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="LblGuidanceTitle" Text="RÉPONSE D'INGÉNIERIE &amp; CITATIONS TECHNIQUES"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource CopilotCyanBrush}" />
                    </StackPanel>

                    <!-- Telemetry KPI Bar -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="12,8" Margin="0,10,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblLatencyHeader" Text="CHRONO / DURÉE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="LblLatency" Text="-- ms" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblThroughputHeader" Text="VITESSE TEMPS RÉEL" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="LblThroughput" Text="-- tok/s" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="LblTokensHeader" Text="JETONS GÉNÉRÉS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="LblTokens" Text="-- tok" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NpuGreenBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock x:Name="LblSourceHeader" Text="SOURCE TECHNIQUE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="LblSourceDoc" Text="Manuel HVAC v2.4 (Interne)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource NpuGreenBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Live Pipeline & Reasoning Steps Tracker -->
                    <Border Grid.Row="2" Background="#111B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Pipeline Steps Pills -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="PillStep1" Background="#1E293B" CornerRadius="4" Padding="7,3" Margin="0,0,5,0">
                                    <TextBlock x:Name="TxtStep1" Text="1. RAG Manuel Interne" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                                <TextBlock Text="›" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11" />
                                <Border x:Name="PillStep2" Background="#1E293B" CornerRadius="4" Padding="7,3" Margin="0,0,5,0">
                                    <TextBlock x:Name="TxtStep2" Text="2. Prefill Silicium" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                                <TextBlock Text="›" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11" />
                                <Border x:Name="PillStep3" Background="#1E293B" CornerRadius="4" Padding="7,3" Margin="0,0,5,0">
                                    <TextBlock x:Name="TxtStep3" Text="3. Raisonnement &amp; Citations" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                                <TextBlock Text="›" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11" />
                                <Border x:Name="PillStep4" Background="#1E293B" CornerRadius="4" Padding="7,3">
                                    <TextBlock x:Name="TxtStep4" Text="4. Données Préservées" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Live Status Description -->
                            <TextBlock Grid.Row="1" x:Name="LblLiveStatus"
                                       Text="Prêt • En attente de question d'ingénierie"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                        </Grid>
                    </Border>

                    <!-- Streaming Output -->
                    <ScrollViewer Grid.Row="3" x:Name="ScrollerOutput" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtOutput"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Text="Posez une question technique pour interroger le manuel d'ingénierie local..." />
                    </ScrollViewer>

                    <!-- Notice -->
                    <Border Grid.Row="4" Background="#162033" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                        <TextBlock x:Name="LblNotice" Text="ℹ️ Données d'entreprise : Le manuel technique et votre requête ne quittent jamais ce PC (aucun appel Cloud)."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
