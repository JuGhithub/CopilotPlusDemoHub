                                                <TextBlock x:Name="TxtRawEnergy" Text="Energy: ~1.71 J" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" />
                                                <Border Background="#251218" CornerRadius="3" Padding="4,2" Margin="0,4,0,0">
                                                    <TextBlock Text="High Compute Cycles • Heat" FontSize="9" Foreground="#F87171" HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="➔" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" Margin="8,0" />

                                        <!-- Olive -->
                                        <Border Grid.Column="2" Background="#0A2218" BorderBrush="{StaticResource NpuGreenBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="✅ Olive Optimized (FP16)" FontSize="10" Foreground="#6EE7B7" FontWeight="SemiBold" />
                                                <TextBlock x:Name="TxtOlivePower" Text="7.8 W" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                                                <TextBlock x:Name="TxtOliveEnergy" Text="Energy: ~0.11 J" FontSize="10" Foreground="#A7F3D0" Margin="0,1,0,0" />
                                                <Border Background="#0E2E20" CornerRadius="3" Padding="4,2" Margin="0,4,0,0">
                                                    <TextBlock Text="Silent • Extended Battery Life" FontSize="9" Foreground="#6EE7B7" HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Client Takeaway -->
                                    <Border Grid.Row="2" Background="#0C1424" CornerRadius="6" Padding="8,6" Margin="0,2,0,0">
                                        <TextBlock x:Name="LblKpiEnergyDesc" Text="💡 Executive Takeaway: Drastically lowers energy consumed per inference, keeping enterprise laptops cool, completely silent, and extending all-day battery life." FontSize="10.5" Foreground="#E2E8F0" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- HERO KPI CARD 4: DETECTION PRECISION & FIDELITY -->
                            <Border Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="16" Margin="0,0,6,0" />
                                            <TextBlock x:Name="LblKpiFidelityTitle" Text="4. DETECTION PRECISION &amp; ACCURACY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#0C2A1E" BorderBrush="{StaticResource NpuGreenBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                            <TextBlock x:Name="TxtFidelityCardBadge" Text="100% PRESERVED" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource NpuGreenBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Comparison Values -->
                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Raw -->
                                        <Border Grid.Column="0" Background="#140E14" BorderBrush="#3B1E29" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="❌ Raw FP32 Output" FontSize="10" Foreground="#FCA5A5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="TxtRawDetCount" Text="4 Objects" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0" />
                                                <TextBlock Text="Precision Baseline: 100%" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" />
                                                <Border Background="#251218" CornerRadius="3" Padding="4,2" Margin="0,4,0,0">
                                                    <TextBlock Text="Standard Bounding Boxes" FontSize="9" Foreground="#F87171" HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="➔" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" Margin="8,0" />

                                        <!-- Olive -->
                                        <Border Grid.Column="2" Background="#0A2218" BorderBrush="{StaticResource NpuGreenBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="✅ Olive FP16 Output" FontSize="10" Foreground="#6EE7B7" FontWeight="SemiBold" />
                                                <TextBlock x:Name="TxtOliveDetCount" Text="4 Objects" FontSize="20" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                                                <TextBlock Text="Exact Match: 0% Degradation" FontSize="10" Foreground="#A7F3D0" Margin="0,1,0,0" />
                                                <Border Background="#0E2E20" CornerRadius="3" Padding="4,2" Margin="0,4,0,0">
                                                    <TextBlock Text="Identical Detections &amp; Classes" FontSize="9" Foreground="#6EE7B7" HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Client Takeaway -->
                                    <Border Grid.Row="2" Background="#0C1424" CornerRadius="6" Padding="8,6" Margin="0,2,0,0">
                                        <TextBlock x:Name="LblKpiFidelityDesc" Text="💡 Executive Takeaway: Quantization from FP32 to FP16 cuts model weight in half without losing a single detection or degrading confidence scores." FontSize="10.5" Foreground="#E2E8F0" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- TECHNICAL AUDIT PIPELINE EXPLAINER -->
                            <Expander Header="🔍 Technical Audit (Microsoft Olive Pipeline Details)..." 
                                      IsExpanded="False" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,4,0,0">
                                <Border Background="#0C1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblAuditTitle" Text="MICROSOFT OLIVE OPTIMIZATION PIPELINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtPassesDesc" Text="1️⃣ Graph Optimization (Dead code pruning) • 2️⃣ FP16 Quantization • 3️⃣ DirectML / NPU Kernel Fusion" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
