<UserControl x:Class="CopilotPlusDemoHub.UI.Views.FleetTelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header & Machine Identity Banner -->
                <Border Grid.Row="0" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title + Live Badge + Header CTA -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LblFleetTitle" Text="GOUVERNANCE DSI, AUDITABILITÉ &amp; TÉLÉMÉTRIE DE FLOTTE"
                                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="LblFleetSub" Text="Preuve formelle pour RSSI &amp; DSI : Traçabilité complète, détection de dérive, alertes de fallback et bilan carbone 100% vérifiable."
                                           FontSize="12" Margin="30,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0C1424" BorderBrush="#2A3B5C" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource NpuGreenBrush}" Margin="0,0,7,0" />
                                        <TextBlock x:Name="LblDbStatus" Text="SQLite Local Synchronisé • ISO 27001 Ready" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NpuGreenBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="BadgeModelContainer" Background="#162238" BorderBrush="{StaticResource CopilotBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Supervision multi-modèles de l'ensemble des cas d'usage">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtModelBadge" Text="Supervision : Multi-Modèles (Phi-4, YOLO, Whisper, LCM)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnExportCsvHeader" Content="📥 Exporter Audit CSV" Style="{StaticResource ModernButtonStyle}"
                                        Background="#0284C7" Height="32" Padding="14,0" FontWeight="Bold" Margin="0,0,10,0"
                                        Click="BtnExportCsv_Click" ToolTip="Exporter vers Excel, Power BI ou Splunk" />
                                <Button x:Name="BtnDocHelp" Style="{StaticResource ModernButtonStyle}"
                                        Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        Height="32" Padding="12,0" VerticalAlignment="Center"
                                        ToolTip="Documentation &amp; Guide de démonstration (FR / EN)" Click="BtnDocHelp_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="❓" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock x:Name="TxtDocHelp" Text="Guide &amp; Doc" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Hardware Discovery Pills -->
                        <WrapPanel Grid.Row="1" Margin="30,12,0,0" Orientation="Horizontal">
                            <Border Background="#1A253A" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtHardwareModel" Text="💻 Modèle : Dell Pro 14 Plus" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#1A253A" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtHardwareTag" Text="🏷️ N° Série / Tag : 9RQ4FB4" FontSize="11" Foreground="{StaticResource CopilotCyanBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#1A253A" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtHardwareHost" Text="🖥️ Hostname : PC-LOCAL" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="#1A253A" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtHardwareCpu" Text="⚙️ Intel Core Ultra 7 268V" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="#0F291E" BorderBrush="#1B4D36" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtHardwareNpu" Text="⚡ NPU 48 TOPS Actif" FontSize="11" Foreground="{StaticResource NpuGreenBrush}" FontWeight="Bold" />
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 2. 4 Executive KPI Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Taux Usage NPU -->
                    <Border Grid.Column="0" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="LblKpiNpuAdoptionTitle" Text="TAUX D'USAGE NPU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtKpiNpuAdoptionVal" Text="-- %" FontSize="22" FontWeight="Black" Foreground="{StaticResource NpuGreenBrush}" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtKpiNpuAdoptionSub" Text="0 inférence sur NPU 48 TOPS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Anomalies & Dérives -->
                    <Border Grid.Column="2" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="LblKpiAnomaliesTitle" Text="ANOMALIES &amp; DÉRIVES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtKpiAnomaliesVal" Text="0 alerte" FontSize="22" FontWeight="Black" Foreground="{StaticResource CopilotCyanBrush}" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtKpiAnomaliesSub" Text="Aucun fallback NPU anormal" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Énergie Économisée ESG -->
                    <Border Grid.Column="4" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="LblKpiEsgTitle" Text="ÉNERGIE ÉCONOMISÉE (ESG)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtKpiEsgVal" Text="0.0 Wh" FontSize="22" FontWeight="Black" Foreground="{StaticResource NpuGreenBrush}" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtKpiEsgSub" Text="~0.0 g CO2 évités vs GPU" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Total Actions Auditées -->
                    <Border Grid.Column="6" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="LblKpiTotalTitle" Text="ACTIONS LOCALES AUDITÉES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtKpiTotalVal" Text="0" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtKpiTotalSub" Text="100% stocké en base SQLite locale" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Filter Bar & Action CTAs -->
                <Border Grid.Row="2" Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Filters -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <!-- Filter Demo -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,6">
                                <TextBlock x:Name="LblFilterDemo" Text="Démo :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbFilterDemo" Width="195" Height="30" FontSize="11" Background="#0C1424" Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="Filter_Changed">
                                    <ComboBoxItem Content="Toutes les démos" Tag="ALL" IsSelected="True" />
                                    <ComboBoxItem Content="🧹 Gomme Magique" Tag="Gomme" />
                                    <ComboBoxItem Content="🎨 Studio Avatar 3D" Tag="Avatar" />
                                    <ComboBoxItem Content="🎙️ Audio Studio Whisper" Tag="Audio" />
                                    <ComboBoxItem Content="🏢 Opérations CVC" Tag="Opérations" />
                                    <ComboBoxItem Content="⚙️ Ingénierie RAG" Tag="Ingénierie" />
                                    <ComboBoxItem Content="📋 Assurance Sinistres" Tag="Assurance" />
                                    <ComboBoxItem Content="💼 Services Financiers" Tag="Finance" />
                                    <ComboBoxItem Content="🔋 Benchmark Énergie" Tag="Benchmark" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Filter Silicon -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,6">
                                <TextBlock x:Name="LblFilterSilicon" Text="Silicium :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbFilterSilicon" Width="130" Height="30" FontSize="11" Background="#0C1424" Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="Filter_Changed">
                                    <ComboBoxItem Content="Toutes les puces" Tag="ALL" IsSelected="True" />
                                    <ComboBoxItem Content="⚡ NPU uniquement" Tag="NPU" />
                                    <ComboBoxItem Content="🎮 GPU uniquement" Tag="GPU" />
                                    <ComboBoxItem Content="💻 CPU uniquement" Tag="CPU" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Filter Anomalies Only -->
                            <CheckBox x:Name="ChkAnomaliesOnly" Content="⚠️ Alertes &amp; Dérives uniquement" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,18,6" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        </WrapPanel>

                        <!-- Row 1: Action Buttons (Always 100% visible regardless of screen resolution) -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnExportCsv" Content="📥 Exporter Audit CSV" Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="32" Padding="14,0" Margin="0,0,10,4" FontWeight="Bold" FontSize="11.5" Click="BtnExportCsv_Click" ToolTip="Exporter vers Excel, Power BI ou Splunk" />
                            <Button x:Name="BtnRefresh" Content="🔄 Actualiser" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="32" Padding="12,0" Margin="0,0,10,4" Click="BtnRefresh_Click" />
                            <Button x:Name="BtnSimulateSiem" Content="🌐 Simuler Sync SIEM" Style="{StaticResource ModernButtonStyle}" Background="#1A253A" Height="32" Padding="12,0" Margin="0,0,10,4" Click="BtnSimulateSiem_Click" ToolTip="Démontrer l'envoi vers un endpoint REST SIEM d'entreprise (Splunk / Azure Sentinel)" />
                            <Button x:Name="BtnClearLog" Content="🗑️ Vider" Style="{StaticResource ModernButtonStyle}" Background="#3F1E24" Foreground="{StaticResource DangerRedBrush}" Height="32" Padding="10,0" Margin="0,0,10,4" Click="BtnClearLog_Click" ToolTip="Effacer le journal d'audit local pour une nouvelle session de démonstration" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 4. Interactive Live Audit DataGrid -->
                <Border Grid.Row="3" Background="#0C1424" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinHeight="320" Margin="0,0,0,16">
                    <DataGrid x:Name="GridAuditLog" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" RowBackground="#0E1626" AlternatingRowBackground="#111B30"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                              HeadersVisibility="Column" SelectionMode="Single" CanUserReorderColumns="False" CanUserResizeRows="False"
                              FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#162035" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#1E293B" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Date &amp; Heure" Binding="{Binding TimestampLocal}" Width="145" />
                            <DataGridTextColumn Header="Démo / Action" Binding="{Binding DemoName}" Width="170" />
                            <DataGridTemplateColumn Header="Silicium Exécuté" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="4,2" HorizontalAlignment="Left"
                                                Background="{Binding SiliconBadgeColor}">
                                            <TextBlock Text="{Binding SiliconDeviceName}" FontWeight="SemiBold" FontSize="10.5"
                                                       Foreground="{Binding SiliconBadgeForeground}" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Latence" Binding="{Binding FormattedLatency}" Width="85" />
                            <DataGridTextColumn Header="Puissance" Binding="{Binding FormattedPower}" Width="85" />
                            <DataGridTextColumn Header="Énergie" Binding="{Binding FormattedEnergy}" Width="85" />
                            <DataGridTextColumn Header="Économie NPU" Binding="{Binding FormattedSavedVsGpu}" Width="110" />
                            <DataGridTemplateColumn Header="Alerte &amp; Statut" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="4,2" HorizontalAlignment="Left"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding AnomalyBadge}" FontWeight="Bold" FontSize="10"
                                                       Foreground="{Binding StatusForeground}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Poste / Tag" Binding="{Binding DeviceId}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 5. Architecture & Governance Explainer Card -->
                <Border Grid.Row="4" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Width="40" Height="40" VerticalAlignment="Center">
                            <TextBlock Text="🏛️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LblGovTitle" Text="POURQUOI CETTE TÉLÉMÉTRIE LOCALE RÉPOND AUX EXIGENCES DSI &amp; RSSI :"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                            <TextBlock x:Name="LblGovDesc" Text="1. Zéro Perte de Contrôle : Chaque inférence IA locale est tracée avec son horodatage, son identifiant de poste, sa puce et sa latence sans envoyer aucune donnée utilisateur vers un cloud public. 2. Détection de Dérive Proactive : Si les performances ralentissent de plus de 25% (thermal throttling ou dégradation de pilote), une alerte est enregistrée. 3. Conformité CSRD &amp; Green IT : Les Watt-heures et le bilan carbone économisés par le NPU sont mesurables et exportables directement pour les rapports RSE d'entreprise."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
