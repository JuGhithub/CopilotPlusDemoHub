<UserControl x:Class="CopilotPlusDemoHub.UI.Views.PdfStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header Banner -->
                <Border Grid.Row="0" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📑" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="LblPdfTitle" Text="STUDIO PDF &amp; OCR SOUVERAIN (ÉDITION LÉGALE &amp; NUMÉRISATION)"
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="LblPdfSub" Text="Preuve pour DSI &amp; Juristes : Reconnaissance de texte OCR (ONNX) et modification légale de PDF 100% locales, sans licence payante Adobe Pro ni API Cloud."
                                       FontSize="12" Margin="32,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0C1424" BorderBrush="#2A3B5C" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource NpuGreenBrush}" Margin="0,0,7,0" />
                                    <TextBlock x:Name="LblComplianceBadge" Text="0€ Licence • Zéro Fuite Cloud • RGPD Art. 17" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NpuGreenBrush}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="BadgeModelContainer" Background="#162238" BorderBrush="{StaticResource CopilotBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Modèle d'Intelligence Artificielle exécuté localement">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtModelBadge" Text="Modèle : RapidOCR Text Detection &amp; Recognition (ONNX/OV)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnDocHelp" Style="{StaticResource ModernButtonStyle}"
                                    Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    Height="32" Padding="12,0" VerticalAlignment="Center"
                                    ToolTip="Documentation &amp; Guide de démonstration (FR / EN)" Click="BtnDocHelp_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="❓" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TxtDocHelp" Text="Guide &amp; Doc" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Document Selection Bar -->
                <Border Grid.Row="1" Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnSampleContract" Content="📄 Exemple Contrat Cadre (PDF)"
                                ToolTip="Contrat de prestation avec clauses, coordonnées bancaires (IBAN), emails et signataires"
                                Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="32" Padding="12,0"
                                Click="BtnSampleContract_Click" />

                        <Button Grid.Column="2" x:Name="BtnSampleInvoice" Content="🧾 Exemple Facture Numérisée (Scan)"
                                ToolTip="Facture de maintenance scannée avec tableau de prix et montants pour tester l'OCR"
                                Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="32" Padding="12,0"
                                Click="BtnSampleInvoice_Click" />

                        <Button Grid.Column="4" x:Name="BtnImportDoc" Content="📂 Importer un Document (PDF / Image)"
                                ToolTip="Charger n'importe quel fichier PDF ou image scannée depuis votre poste"
                                Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="32" Padding="14,0" FontWeight="SemiBold"
                                Click="BtnImportDoc_Click" />

                        <!-- Active Hardware Chip Indicator -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Accélérateur :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="#1A253A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource NpuGreenBrush}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TxtActiveDevice" Text="⚡ NPU (DirectML / ONNX)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Mode Toggle (OCR vs Édition/Caviardage) -->
                <Border Grid.Row="2" Background="#0C1424" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" x:Name="RadModeOcr" GroupName="PdfModeGrp" IsChecked="True"
                                     Style="{StaticResource PillButtonStyle}" Height="36" FontSize="12.5" FontWeight="Bold"
                                     Checked="Mode_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍  MODE 1 : RECONNAISSANCE OCR &amp; EXTRACTION STRUCTURÉE" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1" x:Name="RadModeEdit" GroupName="PdfModeGrp"
                                     Style="{StaticResource PillButtonStyle}" Height="36" FontSize="12.5" FontWeight="Bold"
                                     Checked="Mode_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✍️  MODE 2 : ÉDITION LÉGALE, CAVIARDAGE RGPD &amp; TAMPONS" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- 4. Main Two-Column Studio Area -->
                <Grid Grid.Row="3" MinHeight="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Document Visualizer Card -->
                    <Border Grid.Column="0" Background="#0C1424" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Document Info Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDocName" Text="📄 contrat_cadre_prestation.pdf" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="LblDocPages" Text="(Page 1/1 • A4 Vectoriel)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,1,0,0" />
                                </StackPanel>

                                <!-- View Mode Toggle & Open Button -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnViewOriginal" Content="Document Brut" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="26" Padding="8,0" Margin="0,0,6,0" Click="BtnViewOriginal_Click" />
                                    <Button x:Name="BtnViewOverlay" Content="Zones OCR Cyan" Style="{StaticResource ModernButtonStyle}" Background="#132F4C" Foreground="{StaticResource CopilotCyanBrush}" Height="26" Padding="8,0" Margin="0,0,6,0" Click="BtnViewOverlay_Click" />
                                    <Button x:Name="BtnOpenDocHeader" Content="👁️ Ouvrir le Fichier" Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="26" Padding="10,0" Click="BtnOpenExternal_Click" ToolTip="Ouvrir ce document dans le lecteur par défaut (Edge / Acrobat)" />
                                </StackPanel>
                            </Grid>

                            <!-- Document Image Viewer with Mouse Drag Selection & Floating Toolstrip -->
                            <Border Grid.Row="1" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <ScrollViewer x:Name="ScrollerPreview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <Grid x:Name="GridDocContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" />
                                            <Canvas x:Name="CanvasInteractive" Background="Transparent" Margin="8"
                                                    MouseDown="CanvasInteractive_MouseDown"
                                                    MouseMove="CanvasInteractive_MouseMove"
                                                    MouseUp="CanvasInteractive_MouseUp"
                                                    Cursor="IBeam">
                                                <!-- Drag selection marquee -->
                                                <Rectangle x:Name="RectDragSelection" Visibility="Collapsed"
                                                           Stroke="#00D8F6" StrokeThickness="2"
                                                           StrokeDashArray="3 2"
                                                           Fill="#3300D8F6" />
                                            </Canvas>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Top-Right Mouse Selection Hint -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                            Background="#D90C1424" BorderBrush="#2A3B5C" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖱️" FontSize="11" Margin="0,0,4,0" />
                                            <TextBlock x:Name="TxtMouseHint" Text="Sélectionnez du texte à la souris pour modifier au clavier"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Floating Quick Action Bar (Keyboard Direct Replace) -->
                                    <Border x:Name="BarQuickAction" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                            Background="#F20B1626" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <Border Background="#060A12" BorderBrush="#2A3B5C" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" MaxWidth="170">
                                                <TextBlock x:Name="TxtQuickSelectedDisplay" Text="8 500,00 EUR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <TextBlock x:Name="LblQuickReplaceLabel" Text="⌨️ Remplacer par :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="TxtQuickReplaceInput" Width="140" Height="28" Background="#0C1424" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource CopilotCyanBrush}" Padding="6,2" FontSize="11.5" FontWeight="SemiBold"
                                                     VerticalContentAlignment="Center" Margin="0,0,8,0"
                                                     KeyDown="TxtQuickReplaceInput_KeyDown" />

                                            <Button x:Name="BtnQuickExecuteReplace" Content="✏️ Remplacer (Entrée)" Style="{StaticResource ModernButtonStyle}"
                                                    Background="#0284C7" Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"
                                                    Click="BtnQuickExecuteReplace_Click" />
                                            <Button x:Name="BtnQuickExecuteRedact" Content="🛡️ Caviarder" Style="{StaticResource ModernButtonStyle}"
                                                    Background="#7F1D1D" Foreground="#FCA5A5" Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"
                                                    Click="BtnQuickExecuteRedact_Click" />
                                            <Button x:Name="BtnQuickCopy" Content="📋" ToolTip="Copier le texte sélectionné" Style="{StaticResource ModernButtonStyle}"
                                                    Background="#1E293B" Height="28" Width="30" Margin="0,0,6,0"
                                                    Click="BtnQuickCopy_Click" />
                                            <Button x:Name="BtnQuickClose" Content="✕" ToolTip="Fermer la sélection" Style="{StaticResource ModernButtonStyle}"
                                                    Background="#1E293B" Height="28" Width="26"
                                                    Click="BtnQuickClose_Click" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Loading Spinner Overlay -->
                                    <Border x:Name="OverlayBusy" Background="#CC0A0F1D" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ProgressBar Width="160" Height="4" IsIndeterminate="True" Foreground="{StaticResource CopilotCyanBrush}" Background="#1E293B" />
                                            <TextBlock x:Name="TxtBusyMessage" Text="Inférence locale en cours..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,4" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="TxtBusySub" Text="Exécution sur NPU Intel AI Boost • Zéro cloud" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Left Footer Telemetry Pills -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                <Border x:Name="BadgeSpeed" Background="#132F4C" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtInferSpeed" Text="⚡ 75 ms • NPU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                                </Border>
                                <Border x:Name="BadgePower" Background="#0F291E" BorderBrush="{StaticResource NpuGreenBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtPower" Text="🔋 ~2.2 W • 🌱 0.165 J (Sobriété NPU)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NpuGreenBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RIGHT: Controls & Results Panel -->
                    <Border Grid.Column="2" Background="#0C1424" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <Grid>
                            <!-- ======================================================== -->
                            <!-- PANEL A: OCR MODE CONTROLS & STRUCTURED TEXT RESULT      -->
                            <!-- ======================================================== -->
                            <Grid x:Name="PanelOcrMode" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Action CTA -->
                                <Border Grid.Row="0" Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RECONNAISSANCE OPTIQUE NEURALE (RAPIDOCR)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="Scannez et vectorisez tout document scanné, facture ou reçu pour en extraire le texte intégral avec coordonnées spatiales précises." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                        <!-- Engine Selector (Olive FP16 vs Raw FP32) -->
                                        <Border Background="#0C1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <RadioButton Grid.Column="0" x:Name="RadEngineOlive" GroupName="OcrEngineGrp" IsChecked="True"
                                                             Style="{StaticResource PillButtonStyle}" Height="28" FontSize="11" FontWeight="Bold"
                                                             Checked="OcrEngine_Checked">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚡ Modèle Olive (FP16)" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton Grid.Column="1" x:Name="RadEngineRaw" GroupName="OcrEngineGrp"
                                                             Style="{StaticResource PillButtonStyle}" Height="28" FontSize="11" FontWeight="Bold"
                                                             Checked="OcrEngine_Checked">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🌐 Modèle Brut (FP32)" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </Grid>
                                        </Border>

                                        <!-- Live Comparison KPI Badge -->
                                        <Border x:Name="BorderOliveOcrKpi" Background="#0C231B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtOliveOcrKpiTitle" Text="⚡ Optimisation Microsoft Olive Active :" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                                                <TextBlock x:Name="TxtOliveOcrKpiDesc" Text="Poids disque : 9.8 Mo (-34%) • RAM : ~33 Mo (-17%) • Énergie : -50% Joules" FontSize="10" Foreground="#A7F3D0" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Button x:Name="BtnRunOcr" Content="🚀 Lancer l'Extraction OCR Locale (NPU)" Style="{StaticResource ModernButtonStyle}"
                                                Background="#0284C7" Height="34" FontSize="12" FontWeight="Bold" Click="BtnRunOcr_Click" Margin="0,0,0,8" />

                                        <Button x:Name="BtnMakeSearchablePdf" Content="📄 Convertir en PDF Rechercheable (Couche Texte Ctrl+F)" Style="{StaticResource ModernButtonStyle}"
                                                Background="#065F46" Foreground="#6EE7B7" Height="34" FontSize="11.5" FontWeight="Bold" Click="BtnMakeSearchablePdf_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- OCR Metrics Bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TxtOcrStats" Text="En attente du lancement..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnCopyText" Content="📋 Copier Texte" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="28" Padding="10,0" Margin="0,0,6,0" Click="BtnCopyText_Click" />
                                        <Button x:Name="BtnExportTxt" Content="📥 Exporter TXT" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="28" Padding="10,0" Click="BtnExportTxt_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Extracted Text Area -->
                                <Border Grid.Row="2" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TxtOcrResult" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                                 FontSize="11.5" FontFamily="Consolas, Segoe UI"
                                                 SelectionChanged="TxtOcrResult_SelectionChanged"
                                                 Text="Le texte extrait par le réseau de neurones OCR apparaîtra ici..." />
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- PANEL B: LEGAL EDITION & REDACTION CONTROLS             -->
                            <!-- ======================================================== -->
                            <Grid x:Name="PanelEditMode" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Feature 1: True Redaction (GDPR) -->
                                        <Border Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="ANONYMISATION &amp; CAVIARDAGE RGPD IRRÉVERSIBLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="True Redaction légale : Supprime matériellement les données confidentielles du flux PDF sans laisser de traces sous le bandeau noir." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                                <Button x:Name="BtnAutoRedactRgpd" Content="🛡️ Caviarder Données Sensibles (Emails, Tél, IBAN, NIR)"
                                                        Style="{StaticResource ModernButtonStyle}" Background="#7F1D1D" Foreground="#FCA5A5"
                                                        Height="34" FontSize="11.5" FontWeight="Bold" Click="BtnAutoRedactRgpd_Click" Margin="0,0,0,8" />

                                                <!-- Custom keyword redaction -->
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtKeywordToRedact" Grid.Column="0" Height="30" Background="#0C1424" Foreground="{StaticResource TextPrimaryBrush}"
                                                             BorderBrush="#2A3B5C" Padding="8,4" FontSize="11" VerticalContentAlignment="Center"
                                                             Text="Alexandre MOREAU" KeyDown="TxtKeywordToRedact_KeyDown" />
                                                    <Button Grid.Column="2" x:Name="BtnRedactKeyword" Content="Cavier ce terme"
                                                             Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="30" Padding="10,0"
                                                             Click="BtnRedactKeyword_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Feature 2: Official Stamp / Watermark -->
                                        <Border Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="TAMPON OFFICIEL &amp; SCEAU HORODATÉ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NpuGreenBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="Apposez une mention juridique indélébile avec date, heure et référence de conformité." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                                <WrapPanel Margin="0,0,0,10">
                                                    <RadioButton x:Name="RadStampConfidential" GroupName="StampGrp" Content="🔒 CONFIDENTIEL" IsChecked="True" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,4" />
                                                    <RadioButton x:Name="RadStampApproved" GroupName="StampGrp" Content="✅ APPROUVÉ DSI" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,4" />
                                                    <RadioButton x:Name="RadStampCertified" GroupName="StampGrp" Content="📄 COPIE CONFORME" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,4" />
                                                </WrapPanel>

                                                <Button x:Name="BtnApplyStamp" Content="🏷️ Apposer le Tampon Juridique"
                                                        Style="{StaticResource ModernButtonStyle}" Background="#065F46" Foreground="#6EE7B7"
                                                        Height="32" FontSize="11.5" FontWeight="Bold" Click="BtnApplyStamp_Click" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Feature 3: Vector Text Replacement -->
                                        <Border Background="#131F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="✏️" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="REMPLACEMENT DE TEXTE VECTORIEL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="Remplacez directement un terme dans le PDF sans altérer la mise en page originale. (Ou sélectionnez à la souris sur le document à gauche)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                <Grid Margin="0,4,0,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chercher :" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSearchTerm" Height="28" Background="#0C1424" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#2A3B5C" Padding="6,2" FontSize="11" Text="8 500,00 EUR" Margin="0,0,0,6" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Remplacer :" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtReplaceTerm" Height="28" Background="#0C1424" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#2A3B5C" Padding="6,2" FontSize="11" Text="12 000,00 EUR" KeyDown="TxtReplaceTerm_KeyDown" />
                                                </Grid>

                                                <Button x:Name="BtnExecuteReplace" Content="✏️ Remplacer dans le Document (Entrée)"
                                                        Style="{StaticResource ModernButtonStyle}" Background="#1E293B"
                                                        Height="30" FontSize="11" Click="BtnExecuteReplace_Click" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Feature 4: Download & Export Result -->
                                        <Border Background="#0C1B2A" BorderBrush="{StaticResource CopilotCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="SAUVEGARDE &amp; EXPORT DU DOCUMENT CERTIFIÉ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" Margin="0,0,0,8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnSavePdf" Content="💾 Sauvegarder le PDF Modifié"
                                                            Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="34" Padding="14,0" FontWeight="Bold" Margin="0,0,8,0"
                                                            Click="BtnSavePdf_Click" IsEnabled="False" />
                                                    <Button x:Name="BtnOpenExternal" Content="👁️ Ouvrir le Fichier"
                                                            Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="34" Padding="12,0"
                                                            Click="BtnOpenExternal_Click" IsEnabled="False" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Bottom Status Banner -->
                <Border Grid.Row="4" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblStatus" Text="Prêt. Sélectionnez un document échantillon ou importez votre propre fichier."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="100% Souverain • Traçabilité Télémétrie Flotte Active"
                                   FontSize="10.5" Foreground="{StaticResource NpuGreenBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
