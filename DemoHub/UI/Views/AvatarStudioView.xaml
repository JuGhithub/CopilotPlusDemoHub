<UserControl x:Class="CopilotPlusDemoHub.UI.Views.AvatarStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="LblAvatarTitle" Text="🎨 STUDIO AVATAR IA : STYLISATION CARTOON 3D"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LblAvatarSub" Text="Cas d'usage 100% réel : Transformation photo Image-to-Image sur Silicium Intel Lunar Lake (NPU 48 TOPS / GPU Intel Arc)"
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeModelContainer" Background="#162238" BorderBrush="{StaticResource CopilotBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Modèle d'Intelligence Artificielle exécuté localement">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtModelBadge" Text="Modèle : LCM DreamShaper (Diffusion 8-bit NPU)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnDocHelp" Style="{StaticResource ModernButtonStyle}"
                                Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                Height="32" Padding="12,0" VerticalAlignment="Center"
                                ToolTip="Documentation &amp; Guide de démonstration (FR / EN)" Click="BtnDocHelp_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="❓" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock x:Name="TxtDocHelp" Text="Guide &amp; Doc" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Source Selector & Settings Bar -->
                <Border Grid.Row="1" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Image Source Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnImportImage" Content="📁 Importer une Photo"
                                    ToolTip="Sélectionner une photo depuis votre PC (JPG, PNG)"
                                    Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="32" Padding="12,0"
                                    Click="BtnImportImage_Click" />

                            <Button Grid.Column="2" x:Name="BtnSampleMan" Content="👤 Portrait Homme"
                                    ToolTip="Charger l'échantillon portrait masculin"
                                    Style="{StaticResource ModernButtonStyle}" Background="#1A253A" Height="32" Padding="10,0"
                                    Click="BtnSampleMan_Click" />

                            <Button Grid.Column="4" x:Name="BtnSampleWoman" Content="👩 Portrait Femme"
                                    ToolTip="Charger l'échantillon portrait féminin"
                                    Style="{StaticResource ModernButtonStyle}" Background="#1A253A" Height="32" Padding="10,0"
                                    Click="BtnSampleWoman_Click" />

                            <Button Grid.Column="6" x:Name="BtnWebcam" Content="📸 Photo Caméra"
                                    ToolTip="Prendre une photo avec la webcam intégrée du PC"
                                    Style="{StaticResource ModernButtonStyle}" Background="#1A253A" Height="32" Padding="10,0"
                                    Click="BtnWebcam_Click" />

                            <!-- Accelerator Selector -->
                            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LblAvatarAcceleratorLabel" Text="ACCÉLÉRATEUR :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton x:Name="RadDeviceNpu" GroupName="DevGrp" Content="⚡ NPU AI Boost (1.3s)" IsChecked="True" Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" Checked="Device_Checked" ToolTip="Exécution ultra-rapide sur NPU 48 TOPS (Très basse consommation ~5W)" />
                                <RadioButton x:Name="RadDeviceGpu" GroupName="DevGrp" Content="🎮 GPU Intel Arc (4.7s)" Style="{StaticResource PillButtonStyle}" Checked="Device_Checked" ToolTip="Exécution sur GPU Xe2 Intel Arc 140V (~15W)" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Styles, Subject Fidelity, Intensity -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Style Pills -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LblAvatarStyleLabel" Text="STYLE :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton x:Name="RadStyleCartoon" GroupName="StyleGrp" Content="🎨 Cartoon 3D" IsChecked="True" Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" Checked="Style_Checked" />
                                <RadioButton x:Name="RadStyleAnime" GroupName="StyleGrp" Content="🎬 Anime Studio" Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" Checked="Style_Checked" />
                                <RadioButton x:Name="RadStyleCyberpunk" GroupName="StyleGrp" Content="⚡ Cyberpunk 3D" Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" Checked="Style_Checked" />
                                <RadioButton x:Name="RadStyleVintage60s" GroupName="StyleGrp" Content="🎞️ Années 60" Style="{StaticResource PillButtonStyle}" Checked="Style_Checked" ToolTip="Vieillissement photo argentique style années 1960 (grain Kodachrome, sépia chaud, patine d'époque)" />
                            </StackPanel>

                            <!-- Subject / Gender Fidelity -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LblAvatarGenderLabel" Text="SUJET :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton x:Name="RadGenderAuto" GroupName="GenderGrp" Content="🤖 Auto" IsChecked="True" Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" ToolTip="Détection automatique intelligente du genre et préservation des traits" />
                                <RadioButton x:Name="RadGenderMale" GroupName="GenderGrp" Content="👨 Homme" Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" ToolTip="Préserve strictement les traits masculins, barbe et mâchoire (anti-dérive)" />
                                <RadioButton x:Name="RadGenderFemale" GroupName="GenderGrp" Content="👩 Femme" Style="{StaticResource PillButtonStyle}" ToolTip="Préserve strictement les traits féminins, regard et chevelure" />
                            </StackPanel>

                            <!-- Transformation Intensity Slider (Strength) -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" MaxWidth="220" HorizontalAlignment="Right">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock x:Name="LblAvatarIntensityLabel" Text="FIDÉLITÉ VISAGE :" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" ToolTip="45% = Équilibre idéal entre ressemblance parfaite et stylisation 3D" />
                                    <TextBlock x:Name="LblStrengthVal" Text="45%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SliderStrength" Minimum="0.30" Maximum="0.75" Value="0.45" SmallChange="0.05" LargeChange="0.10"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        ValueChanged="SliderStrength_ValueChanged" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: Dedicated Full-Width Action Banner with Prominent CTA Button -->
                        <Border Grid.Row="4" Background="#0C1322" BorderBrush="#1F2E4A" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Transformation Image-to-Image locale par Diffusion Latente (LCM)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="• Confiné sur ce PC" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="BtnGenerateAvatar" Content="✨ Lancer la Conversion de Style (⚡ NPU Intel AI Boost)"
                                        ToolTip="Lancer l'inférence Image-to-Image ultra-rapide sur NPU 48 TOPS (1.3s, ~5W)"
                                        Style="{StaticResource ModernButtonStyle}" Background="{StaticResource CopilotBlueBrush}"
                                        Foreground="White" FontWeight="Bold" FontSize="12.5" Height="34" HorizontalAlignment="Right" Padding="18,0"
                                        Click="BtnGenerateAvatar_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Main Workspace: Side-by-Side Comparison -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Source Photo -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="LblSourceCardTitle" Text="📷 PHOTO SOURCE (PORTRAIT)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                            <Border Grid.Row="1" Background="#0C1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="380">
                                <Grid>
                                    <Image x:Name="ImgSource" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSourcePlaceholder" Text="Glissez-déposez une photo ici&#x0a;ou cliquez sur Importer"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2" x:Name="LblSourceInfo" Text="portrait_homme.jpg (512 x 512)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- Right Card: Generated 3D Cartoon Avatar -->
                    <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header: Title + Export Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="LblResultCardTitle" Text="✨ AVATAR 3D GÉNÉRÉ (NPU INTEL AI BOOST)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" VerticalAlignment="Center" />
                                <Button x:Name="BtnSaveAvatar" Content="💾 Sauvegarder l'Image"
                                        Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="11" Height="26" Padding="10,0" HorizontalAlignment="Right"
                                        Click="BtnSaveAvatar_Click" IsEnabled="False" />
                            </Grid>

                            <!-- Image Container / Progress Overlay -->
                            <Border Grid.Row="1" Background="#0C1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="380">
                                <Grid>
                                    <Image x:Name="ImgResult" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Loading / In-Progress Overlay -->
                                    <Border x:Name="OverlayGenerating" Background="#E6080E1A" Visibility="Collapsed" CornerRadius="8">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ProgressBar x:Name="PrgGenerating" IsIndeterminate="True" Width="200" Height="6" Background="#1E293B" Foreground="{StaticResource CopilotCyanBrush}" Margin="0,0,0,14" />
                                            <TextBlock x:Name="LblGeneratingStatus" Text="Inférence IA en cours sur GPU Intel Arc..."
                                                       FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="LblGeneratingSub" Text="Modèle de diffusion LCM en 4 étapes • ~3 à 5 secondes"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Empty Placeholder -->
                                    <StackPanel x:Name="PanelResultPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎨" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock x:Name="LblPlaceholderTitle" Text="Cliquez sur « Générer l'Avatar 3D »" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LblPlaceholderSub" Text="Votre photo sera stylisée en personnage de film d'animation cartoon 3D" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Metrics & Status -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock x:Name="LblResultStatus" Text="Prêt à générer" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border x:Name="BadgeSpeed" Background="#1E293B" CornerRadius="10" Padding="8,2" Margin="0,0,6,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtInferTime" Text="4.76 s" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                                    </Border>
                                    <Border x:Name="BadgeWatts" Background="#1E293B" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtWatts" Text="14.2 W" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NpuGreenBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. Architecture & Technical Explanation Card -->
                <Border Grid.Row="3" Background="#131B2E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LblTechTitle" Text="POURQUOI LE COPILOT+ PC EXCÈLE SUR LA CRÉATION VISUELLE LOCALE :"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource CopilotCyanBrush}" />
                            <TextBlock x:Name="LblTechDesc" Text="Grâce à l'architecture Intel Lunar Lake, vous avez le choix du silicium : le NPU 48 TOPS exécute la diffusion LCM en seulement 1,3 seconde avec une consommation minime (~5W), tandis que l'iGPU Intel Arc 140V Xe2 délivre une puissance de calcul graphique brute avec 16 Go de mémoire partagée. Vos photos restent 100% confinées et sécurisées sur votre PC."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
